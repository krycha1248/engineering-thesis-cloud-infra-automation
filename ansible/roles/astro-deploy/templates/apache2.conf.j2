<VirtualHost *:80>
    ServerName {{ app_domain_name }}
    ServerAlias www.{{ app_domain_name }}

    DocumentRoot /var/www/{{ app_domain_name }}

    <Directory /var/www/{{ app_domain_name }}>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>