listen=YES
listen_ipv6=NO
listen_port=21

anonymous_enable=NO
local_enable=YES
write_enable=YES

chroot_local_user=YES
allow_writeable_chroot=NO

user_sub_token=$USER
local_root=/srv/ftp/$USER

local_umask=022
file_open_mode=0666

pasv_enable=YES
pasv_min_port=40000
pasv_max_port=40100

xferlog_enable=YES
log_ftp_protocol=NO
use_localtime=YES

anon_upload_enable=NO
anon_mkdir_write_enable=NO